{
  "name": "normatia",
  "version": "1.0.0",
  "description": "Official TypeScript SDK for the Normatia building code compliance API",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "echo \"No tests yet\"",
    "lint": "tsc --noEmit",
    "release": "semantic-release"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "semantic-release": "^24.0.0",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/release-notes-generator": "^14.0.0",
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/npm": "^12.0.0",
    "@semantic-release/github": "^10.0.0",
    "@semantic-release/git": "^10.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/normatia/normatia.git"
  },
  "homepage": "https://github.com/normatia/normatia",
  "bugs": {
    "url": "https://github.com/normatia/normatia/issues"
  },
  "keywords": [
    "normatia",
    "building-codes",
    "compliance",
    "spain",
    "cte",
    "aeco",
    "api",
    "sdk"
  ]
}
