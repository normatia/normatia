{
  "inputs": [
    {
      "type": "promptString",
      "id": "normatia-api-key",
      "description": "Normatia API key (sk-normatia-...)",
      "password": true
    }
  ],
  "servers": {
    "normatia": {
      "type": "http",
      "url": "https://mcp.normatia.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${input:normatia-api-key}"
      }
    }
  }
}
